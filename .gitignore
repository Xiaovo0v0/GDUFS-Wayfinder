# CDP 浏览器临时配置（每次运行都会变）
.browser-profile/
.chrome-profile/
.bp2/

# 已解压的第三方技能包
artifacts/mattpocock/

# 依赖与临时产物
node_modules/
__pycache__/
*.pyc
*.log
tmp/
temp/

# 录屏中间帧（体积大，可重新生成）
artifacts/video/**/frames/
artifacts/video/norm/

# 团队个人信息，不进仓库
deliverables/team.json

# 审计时解压的副本，不需要进仓库
artifacts/audit/
artifacts/video/seq/

# ============ 协作仓库策略（2026-10-22）============
# 1) 密钥：真实 Dify 密钥只放本地，不进仓库
gdufs-3d/ai-config.local.js

# 2) 构建产物：单文件网页的 dist 目录
gdufs-3d/dist/

# 3) 大体积成品：视频与打包 zip 走 GitHub Release，不进仓库
deliverables/*.mp4
deliverables/*.zip

# 4) 打包生成、且内嵌了密钥的单文件网页
deliverables/local-client/*.html

# 5) 截图与验证产物
artifacts/*.png

# 6) artifacts 下只保留 blender 输入（重建模型用），其余都是跑脚本生成的
artifacts/*
!artifacts/blender/
!artifacts/blender/**
# blender 目录里的渲染图、.blend 工程与中间 glb 只是过程产物，保留 json 与 tex/
artifacts/blender/*.blend
artifacts/blender/*.blend1
artifacts/blender/*.glb
artifacts/blender/*.png
artifacts/blender/roads_*.json

# 数据重建前的备份
gdufs-3d/*.before-*
