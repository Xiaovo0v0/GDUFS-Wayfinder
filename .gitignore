# CDP 浏览器临时配置（每次运行都会变）
.browser-profile/
.chrome-profile/
.bp2/

# Blender 安装包（380 MB，重装时可再下载）
tools/dist/

# 已解压的第三方技能包
artifacts/mattpocock/

# 依赖与临时产物
node_modules/
__pycache__/
*.pyc
*.log
tmp/
temp/

# 录屏中间帧（体积大，可重新生成）
artifacts/video/**/frames/
artifacts/video/norm/
tools/bin/

# 团队个人信息，不进仓库
deliverables/team.json

# 审计时解压的副本，不需要进仓库
artifacts/audit/
artifacts/video/seq/

# ============ 协作仓库策略（2026-10-22）============
# 1) 密钥：真实 Dify 密钥只放本地，不进仓库
gdufs-3d/ai-config.local.js
deploy/.env
# frp 配置里有 token，模板进仓库，实际文件留在服务器
deploy/frp/frps.toml
deploy/frp/frpc.toml

# 2) 构建产物：dist 由 tools/build_single_file.mjs 生成
gdufs-3d/dist/

# 3) 大体积成品：视频与打包 zip 走 GitHub Release，不进仓库
deliverables/*.mp4
deliverables/*.zip

# 4) 早期整理版资料包（已被 data/ 与 gdufs-3d/ 取代）
gdufs-south-campus/

# 5) 打包生成、且内嵌了密钥的单文件网页（由 tools/build_single_file.mjs 生成）
deliverables/local-client/*.html

# 6) 截图与验证产物（tools/shot.mjs、verify_local_client 生成）
artifacts/3d/
artifacts/*.png

# 7) artifacts 下只保留 blender 输入（重建模型用），其余都是跑脚本生成的
artifacts/*
!artifacts/blender/
!artifacts/blender/**

# 数据重建前的备份（tools/*.py 生成）
gdufs-3d/*.before-*
